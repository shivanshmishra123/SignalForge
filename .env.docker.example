# Docker Compose Environment Template
# Copy to .env.docker or .env when running with Docker Compose.

APP_ENV=production
APP_NAME=SignalForge API
REPOSITORY_BACKEND=postgres
DATABASE_URL=postgresql+asyncpg://signalforge:signalforge@postgres:5432/signalforge
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
MIGRATIONS_PATH=migrations
MIGRATE_ON_STARTUP=true
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
AUTH_MODE=development

# Gemini LLM Provider (Google AI Studio)
CLASSIFIER_BACKEND=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# Slack Integration
SLACK_BACKEND=fake
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_API_URL=https://slack.com/api

# Auth0 (Optional in Docker Dev mode, Required for Live Production Auth)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.signalforge.io

# Performance & Security
RATE_LIMIT_PER_MINUTE=120
FORCE_JSON_LOGGING=true
ALLOW_PRIVATE_CRAWL_DESTINATIONS=true
