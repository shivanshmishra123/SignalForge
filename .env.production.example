# Copy to your deployment secret manager; do not commit the populated file.
APP_ENV=production
APP_NAME=SignalForge API
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/signalforge
REDIS_URL=redis://:PASSWORD@HOST:6379/0
REPOSITORY_BACKEND=postgres
QUEUE_BACKEND=redis
MIGRATIONS_PATH=migrations
MIGRATE_ON_STARTUP=false
LOG_LEVEL=INFO
FRONTEND_ORIGIN=https://dashboard.example.com
AUTH_MODE=production

# Gemini is the only supported model provider.
CLASSIFIER_BACKEND=gemini
GEMINI_API_KEY=replace-with-secret-manager-value
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# Set SLACK_BACKEND=fake and SLACK_ENABLED=false to deploy without Slack delivery.
SLACK_BACKEND=slack
SLACK_ENABLED=true
SLACK_BOT_TOKEN=xoxb-replace-with-secret-manager-value
SLACK_API_URL=https://slack.com/api

# Auth0 — required when AUTH_MODE=production
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.signalforge.io

# Performance and observability
RATE_LIMIT_PER_MINUTE=120
FORCE_JSON_LOGGING=true
