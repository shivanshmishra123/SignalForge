# Frontend Environment Variables Template
# Copy this file to .env.local for local overrides (never commit .env.local).

# URL of the SignalForge FastAPI Backend
VITE_API_URL=http://localhost:8000

# Auth0 Configuration (Required for Production Auth; leave empty for Dev Header Mode)
# In production, fill these from your Auth0 Dashboard (Application -> Settings)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.signalforge.io
